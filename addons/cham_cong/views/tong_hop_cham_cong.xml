<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_tong_hop_cham_cong_form" model="ir.ui.view">
            <field name="name">tong_hop_cham_cong.form</field>
            <field name="model">tong_hop_cham_cong</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_tinh_lai"
                            string="Tính lại"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('trang_thai', '=', 'da_chot')]}"/>
                        <button name="action_chot"
                            string="Chốt"
                            type="object"
                            class="btn-success"
                            attrs="{'invisible': [('trang_thai', '=', 'da_chot')]}"/>
                        <button name="action_mo_lai"
                            string="Mở lại"
                            type="object"
                            class="btn-warning"
                            attrs="{'invisible': [('trang_thai', '=', 'nhap')]}"/>
                        <field name="trang_thai" widget="statusbar"
                            statusbar_visible="nhap,da_chot"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="ten_tong_hop" readonly="1"/></h1>
                        </div>
                        <group string="Thông tin chung">
                            <group>
                                <field name="nhan_vien_id"/>
                                <field name="phong_ban_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="thang"/>
                                <field name="nam"/>
                            </group>
                        </group>
                        <group string="Thống kê ngày công">
                            <group>
                                <field name="tong_ngay_cong" readonly="1"/>
                                <field name="ngay_di_lam" readonly="1"/>
                                <field name="ngay_di_muon" readonly="1"/>
                                <field name="ngay_ve_som" readonly="1"/>
                            </group>
                            <group>
                                <field name="ngay_di_muon_ve_som" readonly="1"/>
                                <field name="ngay_vang_mat" readonly="1"/>
                                <field name="ngay_vang_mat_co_phep" readonly="1"/>
                            </group>
                        </group>
                        <group string="Thống kê vi phạm">
                            <group>
                                <field name="tong_phut_di_muon" readonly="1"/>
                            </group>
                            <group>
                                <field name="tong_phut_ve_som" readonly="1"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_tong_hop_cham_cong_tree" model="ir.ui.view">
            <field name="name">tong_hop_cham_cong.tree</field>
            <field name="model">tong_hop_cham_cong</field>
            <field name="arch" type="xml">
                <tree decoration-success="trang_thai=='da_chot'"
                      decoration-info="trang_thai=='nhap'">
                    <field name="nhan_vien_id"/>
                    <field name="phong_ban_id"/>
                    <field name="thang"/>
                    <field name="nam"/>
                    <field name="tong_ngay_cong"/>
                    <field name="ngay_di_lam"/>
                    <field name="ngay_di_muon"/>
                    <field name="ngay_ve_som"/>
                    <field name="ngay_vang_mat"/>
                    <field name="ngay_vang_mat_co_phep"/>
                    <field name="tong_phut_di_muon"/>
                    <field name="tong_phut_ve_som"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_tong_hop_cham_cong_search" model="ir.ui.view">
            <field name="name">tong_hop_cham_cong.search</field>
            <field name="model">tong_hop_cham_cong</field>
            <field name="arch" type="xml">
                <search>
                    <field name="nhan_vien_id"/>
                    <field name="phong_ban_id"/>
                    <field name="thang"/>
                    <field name="nam"/>
                    <filter string="Đã chốt" name="da_chot"
                        domain="[('trang_thai','=','da_chot')]"/>
                    <filter string="Chưa chốt" name="nhap"
                        domain="[('trang_thai','=','nhap')]"/>
                    <separator/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Nhân viên" name="group_nhan_vien"
                            context="{'group_by': 'nhan_vien_id'}"/>
                        <filter string="Phòng ban" name="group_phong_ban"
                            context="{'group_by': 'phong_ban_id'}"/>
                        <filter string="Tháng" name="group_thang"
                            context="{'group_by': 'thang'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_tong_hop_cham_cong" model="ir.actions.act_window">
            <field name="name">Tổng hợp chấm công</field>
            <field name="res_model">tong_hop_cham_cong</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_tong_hop_cham_cong_search"/>
        </record>
    </data>
</odoo>