<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Graph View 1: Lương theo tháng (Bar) -->
        <record id="view_bang_luong_graph_thang" model="ir.ui.view">
            <field name="name">bang_luong.graph.thang</field>
            <field name="model">bang_luong</field>
            <field name="arch" type="xml">
                <graph string="Quỹ lương theo tháng" type="bar">
                    <field name="thang" type="row"/>
                    <field name="luong_thuc_lanh" type="measure" string="Lương thực lãnh"/>
                </graph>
            </field>
        </record>

        <!-- Pivot View -->
        <record id="view_bang_luong_pivot" model="ir.ui.view">
            <field name="name">bang_luong.pivot</field>
            <field name="model">bang_luong</field>
            <field name="arch" type="xml">
                <pivot string="Thống kê lương">
                    <field name="nhan_vien_id" type="row"/>
                    <field name="thang" type="col"/>
                    <field name="luong_thuc_lanh" type="measure" string="Lương thực lãnh"/>
                </pivot>
            </field>
        </record>

        <record id="action_dashboard_tinh_luong" model="ir.actions.act_window">
            <field name="name">Dashboard</field>
            <field name="res_model">bang_luong</field>
            <field name="view_mode">graph,pivot,tree,form</field>
        </record>
    </data>
</odoo>