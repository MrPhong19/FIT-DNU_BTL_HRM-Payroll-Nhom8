<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_hop_dong_lao_dong_form" model="ir.ui.view">
            <field name="name">hop_dong_lao_dong.form</field>
            <field name="model">hop_dong_lao_dong</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_huy_hop_dong"
                            string="Hủy hợp đồng"
                            type="object"
                            class="btn-danger"
                            attrs="{'invisible': [('trang_thai', 'in', ['huy', 'het_han'])]}"/>
                        <field name="trang_thai" widget="statusbar"
                            statusbar_visible="nhap,hieu_luc,sap_het_han,het_han"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1><field name="ma_hop_dong"/></h1>
                        </div>
                        <group string="Thông tin hợp đồng">
                            <group>
                                <field name="nhan_vien_id"/>
                                <field name="loai_hop_dong"/>
                                <field name="ngay_ky"/>
                                <field name="ngay_bat_dau"/>
                                <field name="ngay_ket_thuc"/>
                                <field name="so_ngay_con_lai" readonly="1"/>
                                <field name="so_ngay_canh_bao"/>
                            </group>
                            <group>
                                <field name="luong_co_ban"/>
                                <field name="he_so_luong"/>
                                <field name="phu_cap"/>
                            </group>
                        </group>
                        <group string="Ghi chú">
                            <field name="ghi_chu" nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_hop_dong_lao_dong_tree" model="ir.ui.view">
            <field name="name">hop_dong_lao_dong.tree</field>
            <field name="model">hop_dong_lao_dong</field>
            <field name="arch" type="xml">
                <tree decoration-success="trang_thai=='hieu_luc'"
                      decoration-warning="trang_thai=='sap_het_han'"
                      decoration-danger="trang_thai=='het_han'"
                      decoration-muted="trang_thai=='huy'">
                    <field name="ma_hop_dong"/>
                    <field name="nhan_vien_id"/>
                    <field name="loai_hop_dong"/>
                    <field name="ngay_ky"/>
                    <field name="ngay_bat_dau"/>
                    <field name="ngay_ket_thuc"/>
                    <field name="so_ngay_con_lai"/>
                    <field name="luong_co_ban"/>
                    <field name="he_so_luong"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_hop_dong_lao_dong_search" model="ir.ui.view">
            <field name="name">hop_dong_lao_dong.search</field>
            <field name="model">hop_dong_lao_dong</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_hop_dong"/>
                    <field name="nhan_vien_id"/>
                    <field name="loai_hop_dong"/>
                    <filter string="Có hiệu lực" name="hieu_luc"
                        domain="[('trang_thai','=','hieu_luc')]"/>
                    <filter string="Sắp hết hạn" name="sap_het_han"
                        domain="[('trang_thai','=','sap_het_han')]"/>
                    <filter string="Hết hạn" name="het_han"
                        domain="[('trang_thai','=','het_han')]"/>
                    <separator/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Nhân viên" name="group_nhan_vien"
                            context="{'group_by': 'nhan_vien_id'}"/>
                        <filter string="Loại hợp đồng" name="group_loai"
                            context="{'group_by': 'loai_hop_dong'}"/>
                        <filter string="Trạng thái" name="group_trang_thai"
                            context="{'group_by': 'trang_thai'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_hop_dong_lao_dong" model="ir.actions.act_window">
            <field name="name">Hợp đồng lao động</field>
            <field name="res_model">hop_dong_lao_dong</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_hop_dong_lao_dong_search"/>
        </record>
    </data>
</odoo>