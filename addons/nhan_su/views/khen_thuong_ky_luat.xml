<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Form View -->
        <record id="view_khen_thuong_ky_luat_form" model="ir.ui.view">
            <field name="name">khen_thuong_ky_luat.form</field>
            <field name="model">khen_thuong_ky_luat</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_gui_duyet"
                            string="Gửi duyệt"
                            type="object"
                            class="btn-primary"
                            attrs="{'invisible': [('trang_thai', '!=', 'nhap')]}"/>
                        <button name="action_duyet"
                            string="Duyệt"
                            type="object"
                            class="btn-success"
                            attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"/>
                        <button name="action_tu_choi"
                            string="Từ chối"
                            type="object"
                            class="btn-danger"
                            attrs="{'invisible': [('trang_thai', '!=', 'cho_duyet')]}"/>
                        <field name="trang_thai" widget="statusbar"
                            statusbar_visible="nhap,cho_duyet,da_duyet"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="ma_quyet_dinh"/>
                            </h1>
                        </div>
                        <group string="Thông tin quyết định">
                            <group>
                                <field name="nhan_vien_id"/>
                                <field name="loai"/>
                                <field name="hinh_thuc"/>
                                <field name="so_tien"/>
                                <field name="so_tien_thuc" readonly="1"/>
                            </group>
                            <group>
                                <field name="ngay_quyet_dinh"/>
                                <field name="ngay_hieu_luc"/>
                                <field name="thang_ap_dung"/>
                                <field name="nam_ap_dung"/>
                                <field name="nguoi_duyet_id" readonly="1"/>
                                <field name="ngay_duyet" readonly="1"/>
                            </group>
                        </group>
                        <group string="Nội dung">
                            <field name="ly_do" nolabel="1"/>
                        </group>
                        <group string="Ghi chú"
                            attrs="{'invisible': [('trang_thai', '!=', 'tu_choi')]}">
                            <field name="ly_do_tu_choi" nolabel="1"/>
                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>

        <!-- Tree View -->
        <record id="view_khen_thuong_ky_luat_tree" model="ir.ui.view">
            <field name="name">khen_thuong_ky_luat.tree</field>
            <field name="model">khen_thuong_ky_luat</field>
            <field name="arch" type="xml">
                <tree decoration-success="loai=='khen_thuong' and trang_thai=='da_duyet'"
                      decoration-danger="loai=='ky_luat' and trang_thai=='da_duyet'"
                      decoration-warning="trang_thai=='cho_duyet'"
                      decoration-muted="trang_thai=='tu_choi'">
                    <field name="ma_quyet_dinh"/>
                    <field name="nhan_vien_id"/>
                    <field name="loai"/>
                    <field name="hinh_thuc"/>
                    <field name="ngay_quyet_dinh"/>
                    <field name="thang_ap_dung"/>
                    <field name="nam_ap_dung"/>
                    <field name="so_tien"/>
                    <field name="so_tien_thuc"/>
                    <field name="trang_thai"/>
                </tree>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_khen_thuong_ky_luat_search" model="ir.ui.view">
            <field name="name">khen_thuong_ky_luat.search</field>
            <field name="model">khen_thuong_ky_luat</field>
            <field name="arch" type="xml">
                <search>
                    <field name="ma_quyet_dinh"/>
                    <field name="nhan_vien_id"/>
                    <filter string="Khen thưởng" name="khen_thuong"
                        domain="[('loai','=','khen_thuong')]"/>
                    <filter string="Kỷ luật" name="ky_luat"
                        domain="[('loai','=','ky_luat')]"/>
                    <separator/>
                    <filter string="Chờ duyệt" name="cho_duyet"
                        domain="[('trang_thai','=','cho_duyet')]"/>
                    <filter string="Đã duyệt" name="da_duyet"
                        domain="[('trang_thai','=','da_duyet')]"/>
                    <separator/>
                    <group expand="0" string="Nhóm theo">
                        <filter string="Nhân viên" name="group_nhan_vien"
                            context="{'group_by': 'nhan_vien_id'}"/>
                        <filter string="Loại" name="group_loai"
                            context="{'group_by': 'loai'}"/>
                        <filter string="Tháng" name="group_thang"
                            context="{'group_by': 'thang_ap_dung'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_khen_thuong_ky_luat" model="ir.actions.act_window">
            <field name="name">Khen thưởng - Kỷ luật</field>
            <field name="res_model">khen_thuong_ky_luat</field>
            <field name="view_mode">tree,form</field>
            <field name="search_view_id" ref="view_khen_thuong_ky_luat_search"/>
        </record>
    </data>
</odoo>